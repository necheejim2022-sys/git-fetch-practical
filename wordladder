def word_ladder(begin, end, word_list):
    word_set = set(word_list)
    
    if end not in word_set:
        return None

    queue = deque([(begin, [begin])])  # (current_word, path_taken)
    visited = set([begin])

    while queue:
        current_word, path = queue.popleft()

        if current_word == end:
            return path

        # Try changing each letter
        for i in range(len(current_word)):
            for c in 'abcdefghijklmnopqrstuvwxyz':
                new_word = current_word[:i] + c + current_word[i+1:]

                if new_word in word_set and new_word not in visited:
                    visited.add(new_word)
                    queue.append((new_word, path + [new_word]))

    return None


def display_result(begin, end, word_list):
    result = word_ladder(begin, end, word_list)

    print("====================================")
    print("        WORD LADDER RESULT")
    print("====================================\n")

    print(f"Start Word : {begin}")
    print(f"End Word   : {end}")
    print(f"Word List  : {', '.join(word_list)}\n")

    if result:
        print("------------------------------------")
        print("Shortest Transformation Path Found:")
        print("------------------------------------\n")

        for i, word in enumerate(result):
            if i == 0:
                print(f"Step {i+1}: {word}")
            else:
                prev = result[i-1]
                # Find changed letter
                for j in range(len(word)):
                    if word[j] != prev[j]:
                        print(f"Step {i+1}: {word}   (changed '{prev[j]}' → '{word[j]}')")
                        break

        print("\n------------------------------------")
        print(f"Total Steps: {len(result)} words ({len(result)-1} transformations)")
        print("------------------------------------\n")

        print("Ladder Visualization:\n")
        for word in result:
            print(f"   {word}")
            if word != result[-1]:
                print("    ↓")

        print("\n====================================")
        print("Status: SUCCESS ✅")
        print("====================================")

    else:
        print("No transformation path found ❌")


# Example usage
begin = "hit"
end = "cog"
word_list = ["hot", "dot", "dog", "lot", "log", "cog"]

display_result(begin, end, word_list)